# ============================================================
#  通用数据填报系统 v2.0 - 环境变量配置
# ============================================================
#  将此文件中的 "sk-xxxxxx" 替换为您实际的 Dashscope API Key
#  获取地址: https://dashscope.console.aliyun.com/apiKey

# ------------------------------------------------------------
#  阿里 Dashscope (通义千问) API 配置（必填）
# ------------------------------------------------------------

# API Key（从阿里云 Dashscope 控制台获取）
DASHSCOPE_API_KEY=sk-7d17c522ab55457fa965367416a9b4eb

# 主模型 - 用于内容优化、文本润色等复杂任务
# 可选: qwen-plus (推荐, 速度+质量均衡) | qwen-max (最强, 较慢) | qwen-turbo (最快)
DASHSCOPE_MODEL=qwen-plus

# 高速模型 - 用于字段推荐、批量填报等简单任务（必须响应快）
# 可选: qwen-turbo (推荐, 响应最快) | qwen-plus
DASHSCOPE_FAST_MODEL=qwen-turbo

# 请求超时时间（秒）
DASHSCOPE_TIMEOUT=15

# 生成内容的随机性 (0-1, 越大越随机)
DASHSCOPE_TEMPERATURE=0.7

# Top-P 采样 (0-1, 越小越集中在高概率词)
DASHSCOPE_TOP_P=0.9

# ------------------------------------------------------------
#  应用配置
# ------------------------------------------------------------

# 应用名称
APP_TITLE=通用数据填报系统

# 应用版本号
APP_VERSION=2.0.0

# Gradio 监听端口
APP_PORT=7860

# 是否允许公共访问 (true/false)
APP_SHARE=false

# ------------------------------------------------------------
#  数据库配置
# ------------------------------------------------------------

# 数据库文件名（SQLite）
DB_FILE=data_entry_system.db

# ------------------------------------------------------------
#  日志配置
# ------------------------------------------------------------

# 日志文件名
LOG_FILE=app.log

# 日志级别: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
